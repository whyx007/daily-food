  "claims": [
    {"poi_name":"程记米线店","category":"米线","sub_category":"麻辣米线","author_id":"sohu_zipan","url":"https://www.sohu.com/a/445868948_120081421","published_at":"2021-01-21","snippet":"麻辣酸菜米线感觉很带感，是越吃越有味道的那种，米线偏软，汤的味道感觉都融入到了米线里面。"},
    {"poi_name":"程记米线店","category":"米线","sub_category":"红油米线","author_id":"n163_xingchen","url":"http://www.163.com/dy/article/FFH5U2V80545B9G0_pdya11y.html","published_at":"2020-06-19","snippet":"尤其是麻辣米线，里面的辣子味道更是一绝，上面的那层红油油亮油亮的，看着就特别诱人。"},
    {"poi_name":"红红米线店","category":"米线","sub_category":"砂锅米线","author_id":"sohu_zipan","url":"https://www.sohu.com/a/445868948_120081421","published_at":"2021-01-21","snippet":"一个人不知道该吃啥的时候，第一个想到的就是红红米线，一碗麻辣米线再来一小把烤肉，简直了。"},
    {"poi_name":"米线张","category":"米线","sub_category":"麻辣米线","author_id":"sohu_zipan","url":"https://www.sohu.com/a/445868948_120081421","published_at":"2021-01-21","snippet":"麻辣米线、笼笼肉夹馍、茶叶蛋，这三样是标配，麻辣味重，所以吃完嘴很麻。"},
    {"poi_name":"老八米线","category":"米线","sub_category":"干拌米线","author_id":"sohu_zipan","url":"https://www.sohu.com/a/445868948_120081421","published_at":"2021-01-21","snippet":"他家的米线可以加鱼丸，还有干拌、大宽、二宽好多种样式，活生生地把米线吃出了咱陕西人的感觉，比较推荐麻辣的，很给力。"},
    {"poi_name":"纺建米线","category":"米线","sub_category":"麻辣米线","author_id":"sohu_zipan","url":"https://www.sohu.com/a/445868948_120081421","published_at":"2021-01-21","snippet":"纺织城很好吃的一家小馆子，米线是小时候吃的传统的那种细细的米线，放了海带丝和豆腐皮丝，麻辣味很香很麻"},
    {"poi_name":"老满客过桥米线","category":"米线","sub_category":"过桥米线","author_id":"sohu_zipan","url":"https://www.sohu.com/a/445868948_120081421","published_at":"2021-01-21","snippet":"只有资深红旗厂吃货才能找到。很小的一家苍蝇馆子，在红旗厂的小巷子里，来这里的也都是多年的回头客。"},
    {"poi_name":"海家粉蒸肉砂锅米线","category":"米线","sub_category":"砂锅米线","author_id":"sohu_bendibao","url":"https://m.sohu.com/a/954617097_681384/","published_at":"2025-11-15","snippet":"满满的一层油泼辣子+芝麻，配菜和肉的量也很足，吃的很过瘾，美中不足是排队时间有点长。"},
    {"poi_name":"张嫂家红油米线","category":"米线","sub_category":"红油米线","author_id":"sohu_bendibao","url":"https://m.sohu.com/a/954617097_681384/","published_at":"2025-11-15","snippet":"米线咸香麻辣，豆腐泡吸满汤汁，配着小笼包很绝"},
    {"poi_name":"螺小胖柳州螺蛳粉","category":"米线","sub_category":"螺蛳粉","author_id":"n163_xingchen","url":"http://www.163.com/dy/article/FFH5U2V80545B9G0_pdya11y.html","published_at":"2020-06-19","snippet":"位于大话南门后面的这家螺蛳粉店在西安其实分店挺多的，但是经不住他家味道好，因此也深受附近的人们的喜爱"},
    {"poi_name":"重庆欣欣砂锅","category":"米线","sub_category":"砂锅米线","author_id":"sohu_luantan","url":"https://www.sohu.com/a/887601693_348920","published_at":"2025-04-22","snippet":"再一个必点的就是砂锅米线，这家不仅配菜多，米线也给的实在，米线一夹起来全挂上红油，一口下去就是个满足。"},
    {"poi_name":"军良烤肉","category":"烤肉","sub_category":"烤肉","author_id":"n163_meishituan","url":"https://www.163.com/dy/article/CL6KDOBI0522A187.html","published_at":"2017-05-24","snippet":"北郊大名鼎鼎的人气烤肉，据说已经开了20多年。不光烤肉的品质好，就连师傅的手上功夫都跟“无影手”一般。"},
    {"poi_name":"陈记农家挂炉烤肉","category":"烤肉","sub_category":"烤肉","author_id":"n163_meishituan","url":"https://www.163.com/dy/article/CL6KDOBI0522A187.html","published_at":"2017-05-24","snippet":"他家主打的是挂炉烤肉，签子要比一般的烤肉长，不论是牛肉还是羊肉都是论斤上，基本半斤就是十串。"},
    {"poi_name":"小小亮鸡胗王","category":"烤肉","sub_category":"烤肉","author_id":"n163_meishituan","url":"https://www.163.com/dy/article/CL6KDOBI0522A187.html","published_at":"2017-05-24","snippet":"最好吃的一定要数鸡胗，不愧是镇店之宝。热辣脆嫩，很有嚼劲，很适合几个大老爷们下酒。"},
    {"poi_name":"费萨尔烤肉","category":"烤肉","sub_category":"回坊烤肉","author_id":"sohu_bendibao","url":"https://www.sohu.com/a/785998732_681384","published_at":"2024-06-14","snippet":"肉质新鲜，烤馕必点，香辣酥暄，满满的孜然香！"},
    {"poi_name":"安老虎烤肉","category":"烤肉","sub_category":"回坊烤肉","author_id":"sohu_bendibao","url":"https://www.sohu.com/a/785998732_681384","published_at":"2024-06-14","snippet":"喜欢重口味的宝子推荐，蒜蓉烤馕很独特，牛奶鸡蛋醪糟很好喝！"},
